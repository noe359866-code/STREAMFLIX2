{
  "name": "streamflix2-nuvio-es",
  "version": "1.1.1",
  "private": true,
  "description": "Proveedores VOD en español para Nuvio y addon de Stremio para Beamup",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run build && npm test",
    "test:live": "node scripts/live-check.cjs",
    "test:playback": "node scripts/live-check.cjs --playback",
    "start": "node stremio/server.cjs",
    "start:stremio": "node stremio/server.cjs",
    "start:nuvio": "node server.cjs",
    "nuvio:cdn": "node scripts/nuvio-cdn.cjs",
    "deploy:beamup": "bash scripts/deploy-beamup.sh"
  },
  "dependencies": {
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "esbuild": "^0.25.11",
    "stremio-addon-linter": "^1.7.0"
  }
}
