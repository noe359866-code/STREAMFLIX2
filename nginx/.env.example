# Puerto local donde escucha el contenedor o servicio Nginx
NGINX_PORT=8080

# Dominio público de tu servidor Nginx (usa _ para aceptar cualquier Host)
SERVER_NAME=_

# Esquema y dominio precalculado en Beamup para GitHub user noe359866-code + app streamflix2
BEAMUP_SCHEME=https
BEAMUP_HOST=7e2a912be9c9-streamflix2.baby-beamup.club

# Token opcional para restringir el uso de /hlsp/ (deja vacío para acceso abierto)
# Si defines un valor aquí, pon el mismo en /configure o en NGINX_PROXY_TOKEN de Beamup
NGINX_PROXY_TOKEN=

# Servidores DNS públicos para resolver tanto Beamup como los CDNs de vídeo
DNS_RESOLVER=1.1.1.1 8.8.8.8
